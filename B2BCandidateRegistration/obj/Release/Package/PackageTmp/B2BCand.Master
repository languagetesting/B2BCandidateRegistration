<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="B2BCand.master.cs" Inherits="B2BCandidateRegistration.B2BCand" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candidate Registration</title>
    
    <%--<webopt:bundlereference runat="server" path="~/Content/css" />--%>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href="~/Content/B2BSite.css" />
    <script type="text/javascript" src="Scripts/jquery-3.4.1.min.js"></script>
    <script type="text/javascript" src="Scripts/WebForms/B2BCandReg.js"></script>
    
    <asp:ContentPlaceHolder ID="cphhead" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container" style="padding-top:5px;padding-bottom:5px;">
                <img src="Images/lti-logo.png" alt="" title="" class="tms-logo"/>                
            </div>
        </nav>
        <div class="container">
            <asp:ContentPlaceHolder ID="cphMain" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <asp:ContentPlaceHolder ID="cphFooter" runat="server">
            <footer class="footer">
            <div class="container">
                <div class="row">
                    <div class="footer-column col-lg-3 col-md-12 order-2 order-lg-1 mobile-padding">
                        <img src="Images/LTI_logo_Oct_2025_Registered_Digital_White.png" alt="" title="" class="logo-footer"/>
                    </div>
                    <div class="footer-column col-lg-3 col-md-3 order-1 order-lg-2">
						<img src="Images/ACTFL_LTI_COBRAND_Logo.png" class="logo-ACTFLTI">
                    </div>
                    <div class="footer-column col-lg-2 col-md-2 order-1 order-lg-2">
                        <h4>Company</h4>                        
                        <p><a href="https://www.languagetesting.com/lti-information/privacy" target="_blank">Privacy Policy</a></p>
                    </div>
                    <div class="footer-column col-lg-4 col-md-6 order-1 order-lg-2">
                        <h4>Contact Us</h4>
                        <p class="phone">914-963-7110 option 1 or 1-800-486-8444 Option 1</p>
                        <p class="address"><span><span>580 White Plains Rd #660</span> Tarrytown, NY 10591</span></p>
                        <p class="email"><a href="mailto:support@languagetesting.com" target="_blank">support@languagetesting.com</a></p>                        
                    </div>                    
                </div>
				<div class="row">
					<div class="col-sm-12">
						<p class="footer-copyright">&copy;<%= DateTime.Now.Year %> - Language Testing International, Inc</p>
					</div>
				</div>
            </div>			
        </footer>
        </asp:ContentPlaceHolder>

        <div id="xmlPopupMessage"   class="LTIPopUpWrapper LTIPopUpDivider-510px" >
            <div class="LTIPopUpDivider">
                <div id="Div2" class="LTIPopUpCloseButtonContainer">
                    <asp:LinkButton id="LinkButton1" runat="server"  Text="X" ToolTip="Close"  CssClass="LTIPopUpCloseButton"   OnClientClick="hideMessage();return false;"      />
                </div>
            </div>
            <div id="divPopupMessage" align="center" class="LTIPopUpMessage LTIPopUpMessage-15px">
            </div>
        </div>  

    </form>
</body>
</html>
