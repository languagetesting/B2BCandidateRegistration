                                <div class="lti-user-icon"></div>
                                <%= Session["User_FirstName"] %></a>
                            <ul class="nav-dropdown about-lti-menu">
                                <li><a href="ChangePassword.aspx">Change Password</a></li>
                                <li><a href="Login.aspx?timeout=2">Logout</a></li>
                            </ul>
                        </li>                        
                    </ul>
                </div>

            </div>
